# =============================================================================
# ThunderFlow Business Automation — .dockerignore
# Keep build context lean, cache-friendly, and free of host secrets.
# =============================================================================

# Version control — never bake .git into an image layer.
.git
.gitignore
.gitattributes
.github
.gitlab
.husky

# Node dependencies — installed inside the image, not copied from host.
node_modules
**/node_modules

# Build outputs that should not pollute the image cache.
.next
out
dist
build
**/.next
**/out
**/dist
**/build
*.tsbuildinfo

# Next.js generated files.
next-env.d.ts

# Test artifacts — not needed at runtime.
coverage
**/coverage
.nyc_output
test-results
playwright-report
playwright/.cache
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/*.stories.tsx
**/*.stories.ts

# Documentation is served from the marketing site, not the app container.
docs
README.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
LICENSE
*.md
!NOTICE.md

# IDE / editor / OS cruft.
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# Env files — mount secrets at runtime, never bake them into images.
.env
.env.*
!.env.example
*.local

# Docker meta files — they describe the build, not part of it.
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# CI / misc tooling configs.
.env*.yml
.husky
.editorconfig

# Logs & caches.
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.cache
.eslintcache
.stylelintcache
.turbo

# Prisma local databases (migrations are copied explicitly in the Dockerfile).
prisma/*.db
prisma/*.db-journal

# Storybook & docs builds.
storybook-static
.docusaurus

# Local scratch / temp.
tmp
temp
scripts/_scratch
