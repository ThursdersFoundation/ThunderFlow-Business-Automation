# =============================================================================
# ThunderFlow Business Automation — Environment Variables
# =============================================================================
# Copy this file to `.env.local` (for local dev) or `.env` (for production) and
# fill in real values. NEVER commit the real `.env` files to git.
# Every variable below has a safe default so the app boots in development even
# if some integrations are not wired up yet.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public site URL used for metadata, OG tags, sitemap, robots and email links.
# In production set this to your canonical domain (no trailing slash).
NEXT_PUBLIC_APP_URL="https://app.thunderflow.io"

# Public marketing site (used for cross-links from the app shell).
NEXT_PUBLIC_MARKETING_URL="https://thunderflow.io"

# Deployment environment: "development" | "staging" | "production"
NODE_ENV="development"

# App name shown in the UI shell, emails and PWA manifest.
NEXT_PUBLIC_APP_NAME="ThunderFlow"

# Short environment tag surfaced in the topbar (e.g. "Beta", "Staging").
NEXT_PUBLIC_ENV_LABEL="Beta"

# -----------------------------------------------------------------------------
# Auth (NextAuth.js v4 / Auth.js)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-secret"

# Comma-separated list of allowed callback URLs.
AUTH_TRUST_HOST="true"

# OAuth providers — leave blank to disable a provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

OKTA_CLIENT_ID=""
OKTA_CLIENT_SECRET=""
OKTA_ISSUER=""

# Email/password magic-link provider (Resend).
RESEND_API_KEY=""
EMAIL_FROM="ThunderFlow <noreply@thunderflow.io>"

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Prisma reads DATABASE_URL for migrations and the runtime client.
DATABASE_URL="postgresql://thunder:thunder@localhost:5432/thunderflow?schema=public"

# Direct connection used by Prisma Data Proxy / Accelerate (optional).
DIRECT_URL="postgresql://thunder:thunder@localhost:5432/thunderflow?schema=public"

# Connection pool size for the PgBouncer sidecar.
PG_POOL_MAX="10"

# -----------------------------------------------------------------------------
# Cache / Queue / Realtime (Upstash Redis or self-hosted)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_TOKEN=""

# BullMQ / QStash event queue (optional).
QSTASH_URL=""
QSTASH_TOKEN=""

# -----------------------------------------------------------------------------
# Object storage (S3-compatible — AWS, R2, MinIO, etc.)
# -----------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="thunderflow-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL="http://localhost:9000/thunderflow-uploads"

# -----------------------------------------------------------------------------
# Workflow engine
# -----------------------------------------------------------------------------
# Max concurrent workflow runs per tenant. Set per worker pod.
THUNDERFLOW_MAX_CONCURRENCY="25"

# Run timeout in milliseconds (default 5 minutes).
THUNDERFLOW_RUN_TIMEOUT_MS="300000"

# Secret used to sign webhook payloads sent to outbound integrations.
THUNDERFLOW_WEBHOOK_SIGNING_SECRET="replace-with-a-random-secret"

# Sandbox script execution time budget in milliseconds.
THUNDERFLOW_SCRIPT_TIMEOUT_MS="5000"

# -----------------------------------------------------------------------------
# Integrations (optional — only enable what you need)
# -----------------------------------------------------------------------------
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""

HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

AIRTABLE_API_KEY=""

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Sentry DSNs (server + client are separate).
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# OpenTelemetry / OTLP collector endpoint (optional).
OTEL_EXPORTER_OTLP_ENDPOINT=""

# PostHog product analytics (client-side).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Logflare / Better Stack log drain (optional).
LOGFLARE_API_KEY=""

# -----------------------------------------------------------------------------
# Feature flags (LaunchDarkly, Flagsmith, or in-house)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FEATURE_COMMAND_PALETTE="true"
NEXT_PUBLIC_FEATURE_AUDIT_LOG="true"
NEXT_PUBLIC_FEATURE_SSO="false"
NEXT_PUBLIC_FEATURE_WORKFLOW_VERSIONING="true"

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Time zone used for cron scheduling defaults and audit timestamps.
TZ="UTC"

# Next.js telemetry opt-out (run-time only, not read by the app).
NEXT_TELEMETRY_DISABLED="1"
